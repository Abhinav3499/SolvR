{
  "manifest_version": 3,
  "name": "SolvR - LeetCode & Codeforces Problem Importer",
  "version": "1.1.0",
  "description": "1-click add any LeetCode, Codeforces, GeeksforGeeks, or HackerRank problem to your SolvR question sheet.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Add current problem to SolvR"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.leetcode.com/problems/*"
      ],
      "js": ["mainWorldInterceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.leetcode.com/problems/*",
        "*://*.codeforces.com/contest/*/problem/*",
        "*://*.codeforces.com/problemset/problem/*",
        "*://*.geeksforgeeks.org/problems/*",
        "*://*.hackerrank.com/challenges/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.leetcode.com/*",
    "*://*.codeforces.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://*.vercel.app/*",
      "http://localhost:*/*"
    ]
  }
}
